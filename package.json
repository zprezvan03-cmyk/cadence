{
  "name": "cadence-player",
  "version": "0.1.0",
  "private": true,
  "description": "Cadence - a local desktop music player with the Better Lyrics engine and Better Lyrics Shaders effects",
  "author": "Cadence contributors",
  "license": "GPL-3.0",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "npm run build && npx vite-node tests/browser/build-library.ts && node tests/browser/run-app.mjs",
    "test:renderer": "npm run build && node tests/browser/run-harness.mjs",
    "test:fixtures": "python3 tests/fixtures/generate-audio.py",
    "smoke": "node scripts/smoke.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:portable": "node scripts/make-windows-portable.mjs"
  },
  "dependencies": {
    "@braccato/core": "1.16.11",
    "@braccato/parsers": "0.4.0",
    "@braccato/types": "1.0.0",
    "@kawarp/core": "1.3.1",
    "lucide-react": "^0.545.0",
    "music-metadata": "^11.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "lamejs": "^1.2.1",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
