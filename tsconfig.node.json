{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"]
    },
    "noEmit": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/tauri/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/global.d.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
